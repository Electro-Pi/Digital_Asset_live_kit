# Server-only Supabase credentials. Do not prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Generate at least 32 random bytes, for example: openssl rand -hex 32
ADMIN_SESSION_HMAC_SECRET=replace-with-at-least-64-random-hex-characters

# Origin only, no /admin path -- the dashboard is mounted at /admin on this
# origin, but Origin headers and cookie scoping are origin-level. Exactly one
# hostname may serve the dashboard: every mutation is rejected unless the
# browser's Origin header matches this value character for character.
ADMIN_ORIGIN=https://www.coda.eracoda.ai

# Enable only behind the supplied reverse proxy, which overwrites X-Real-IP.
ADMIN_TRUST_PROXY=true

# Used only by `npm run admin:provision`; never place production values here.
ADMIN_OWNER_EMAIL=
ADMIN_OWNER_PASSWORD=
