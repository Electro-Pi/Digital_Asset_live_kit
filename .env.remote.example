# Speech backends for a Coda LiveKit agent running on a DIFFERENT host to the
# gateway. Copy the block below into that project's .env / .env.local.
#
# The difference from a co-located agent is only the URL: loopback becomes the
# public mount, so the traffic crosses the internet and passes through nginx.
# Everything else — auth, metering, the model name — is identical.

# ─── Speech gateway ──────────────────────────────────────────────────────────
# Public mount. NOT 127.0.0.1:8011 — that only works on the gateway's own host.
#
# The key must carry the scopes this agent actually uses, chosen when it was
# issued in the admin dashboard. A LiveKit agent driving STT, LLM and TTS
# separately — which is what agent.py does — needs `tts`, `stt` and `llm`.
# `agent` is a fourth, separate scope covering only /v1/speech-agent, the
# one-call combined turn; an agent that does not call that route does not need
# it. A key used outside its scopes is refused with 403, not 401.
#
# The account behind the key also needs credits, or every route answers 402.
# Grant them from the admin dashboard: Users → the owner → Credits.
#
# The three URLs differ by suffix, and the difference is load-bearing:
#   LLM  takes /v1     — the OpenAI client appends /chat/completions
#   TTS  takes no /v1  — the plugin appends /v1/audio/speech itself
#   STT  takes no /v1  — the plugin appends /v1/audio/transcriptions itself
# Getting it wrong yields /v1/v1/... and a 404. The TTS and STT plugins both
# trim a trailing /v1 defensively, but do not rely on that.
SPEECH_GATEWAY_URL="https://coda.eracoda.ai/api/tts"
SPEECH_GATEWAY_API_KEY="coda_sk_live_lnlAxpx4S9czWtMHBlUnRN4H3A15zkpK"

TTS_SERVER_URL="https://coda.eracoda.ai/api/tts"
TTS_MODEL="Coda-V2"
TTS_VOICE="nouf"
TTS_VOICE_MALE="nawaf"

LLM_BASE_URL="https://coda.eracoda.ai/api/tts/v1"
LLM_MODEL="Coda-V2"
LLM_API_KEY="coda_sk_live_lnlAxpx4S9czWtMHBlUnRN4H3A15zkpK"

STT_BASE_URL="https://coda.eracoda.ai/api/tts"
STT_MODEL="Coda-V2"
STT_API_KEY="coda_sk_live_lnlAxpx4S9czWtMHBlUnRN4H3A15zkpK"

# Raw PCM rate the gateway serves. 48000 is the plugin default and the measured
# truth; set it explicitly here so a future backend change is a config edit
# rather than a silent pitch shift.
TTS_SAMPLE_RATE="48000"

# ─── Speech gate (STT VAD) ───────────────────────────────────────────────────
# Unchanged from the co-located agent — these govern the microphone, not the
# backend, so distance to the gateway does not affect them.
STT_VAD_ACTIVATION_THRESHOLD="0.65"
STT_VAD_DEACTIVATION_THRESHOLD="0.45"
STT_VAD_MIN_SPEECH_DURATION="0.20"
STT_VAD_MIN_SILENCE_DURATION="0.60"
STT_VAD_PREFIX_PADDING_DURATION="0.30"
STT_FOREGROUND_MIN_RMS="0.015"
STT_FOREGROUND_MIN_SNR_DB="8.0"
STT_FOREGROUND_MIN_DURATION="0.20"

# ─── LiveKit ─────────────────────────────────────────────────────────────────
# The new project's own credentials, not Coda's. They must match whatever
# frontend mints its tokens.
LIVEKIT_URL="wss://YOUR-PROJECT.livekit.cloud"
LIVEKIT_API_KEY="REPLACE_ME"
LIVEKIT_API_SECRET="REPLACE_ME"
AGENT_PORT="2953"

# Release sentences promptly; the TTS plugin adds phrase pauses and smooth joins.
TTS_SENTENCE_MIN_LEN="1"
