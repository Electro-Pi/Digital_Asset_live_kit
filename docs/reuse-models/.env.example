# Copy this file into the other project as `.env` and fill in YOUR key.
# Do not commit real keys. The same Coda key works for TTS, LLM, and STT.
#
# The clients in this folder read CODA_API_KEY first, then the role-specific
# *_API_KEY if you ever point the three roles at different hosts.

CODA_API_KEY=coda_sk_REPLACE_ME

# ─── TTS ─────────────────────────────────────────────────────────────────────
# Base URL takes NO /v1 — clients append /v1/audio/speech.
TTS_SERVER_URL=https://coda.eracoda.ai/api/tts
TTS_API_KEY=
TTS_MODEL=Coda-V2
TTS_VOICE=nouf
# Client-side pace only. Do NOT send `speed` to the server — it is a
# resampler that changes pitch. 1.0 = recorded pace.
TTS_SPEED=1.0
TTS_SEED=1234
# 0 = keep tashkeel (recommended). 1 = strip short vowels before TTS.
TTS_STRIP_TASHKEEL=0
# Optional voice clone: set voice=default and point at a short wav + transcript.
# TTS_VOICE=default
# TTS_REF_AUDIO=
# TTS_REF_TEXT=

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Base URL takes /v1 — the OpenAI client appends /chat/completions.
LLM_BASE_URL=https://coda.eracoda.ai/api/tts/v1
LLM_API_KEY=
LLM_MODEL=Coda-V2
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=400

# ─── STT ─────────────────────────────────────────────────────────────────────
# Base URL without /v1 — clients append /v1/audio/transcriptions.
# A trailing /v1 is tolerated and stripped.
STT_BASE_URL=https://coda.eracoda.ai/api/tts
STT_API_KEY=
STT_MODEL=Coda-V2
STT_LANGUAGE=ar

# ─── Optional local / Digital Asset stack (not the live Jahez path) ──────────
# TTS_SERVER_URL=http://localhost:16326
# TTS_MODEL=VoxCPM2
# LLM_BASE_URL=http://127.0.0.1:8001/v1
# LLM_MODEL=gemma4
# STT_BASE_URL=http://localhost:8000
# STT_MODEL=CohereLabs/cohere-transcribe-arabic-07-2026
