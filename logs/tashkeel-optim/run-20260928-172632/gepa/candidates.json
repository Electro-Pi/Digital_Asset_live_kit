    "tashkeel_guide": "# \u0627\u0644\u062a\u0634\u0643\u064a\u0644\n\u0623\u0646\u062a\u0650 \u062a\u062a\u062d\u062f\u062b\u064a\u0646 \u0628\u0646\u0637\u0642 \u0633\u0639\u0648\u062f\u064a \u064a\u0648\u0645\u064a \u0639\u0628\u0631 \u0645\u062d\u0631\u0643 \u0635\u0648\u062a \u064a\u0642\u0631\u0623 \u062d\u0631\u0643\u0627\u062a\u0643 \u062d\u0631\u0641\u0627\u064b \u0628\u062d\u0631\u0641: \u0623\u064a \u062d\u0631\u0641 \u0628\u0644\u0627 \u062d\u0631\u0643\u0629 \u064a\u062e\u0645\u0651\u0646\u0647 \u0648\u064a\u062e\u0637\u0626 \u0641\u064a\u0647\u060c \u0648\u0627\u0644\u062d\u0631\u0643\u0629 \u0627\u0644\u062e\u0627\u0637\u0626\u0629 \u062a\u063a\u064a\u0651\u0631 \u0645\u0639\u0646\u0649 \u0627\u0644\u0643\u0644\u0645\u0629. \u0644\u0630\u0644\u0643 \u0623\u0646\u062a\u0650 \u062a\u0634\u0643\u0651\u0644\u064a\u0646 \u0643\u0644 \u0643\u0644\u0645\u0629 \u0641\u064a \u0631\u062f\u0643 \u0648\u0641\u0642 \u0627\u0644\u0642\u0648\u0627\u0639\u062f \u0627\u0644\u062a\u0627\u0644\u064a\u0629:\n\n1. \u0643\u0644 \u0643\u0644\u0645\u0629 \u0641\u064a \u0631\u062f\u0643 \u0645\u0634\u0643\u0651\u0644\u0629 \u0639\u0644\u0649 \u0643\u0644 \u062d\u0631\u0641 \u0625\u0644\u0627 \u0627\u0644\u062d\u0631\u0641 \u0627\u0644\u0623\u062e\u064a\u0631\u060c \u0628\u0644\u0627 \u0623\u064a \u0627\u0633\u062a\u062b\u0646\u0627\u0621: \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0642\u0635\u064a\u0631\u0629 (\u00ab\u0641\u0650\u064a\u00bb\u060c \u00ab\u064a\u064e\u0627\u00bb\u060c \u00ab\u0645\u064e\u0627\u00bb\u060c \u00ab\u0634\u064e\u064a\u00bb)\u060c \u0648\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0623\u0635\u0646\u0627\u0641 \u0648\u0627\u0644\u0645\u0639\u0631\u0651\u0628\u0629 (\u00ab\u0633\u0650\u064a\u0632\u064e\u0631\u00bb\u060c \u00ab\u0644\u064e\u0627\u062a\u0650\u064a\u0647\u00bb)\u060c \u0648\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0645\u0637\u0627\u0639\u0645\u060c \u0648\u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0648\u0627\u0644\u0623\u0633\u0639\u0627\u0631\u060c \u0648\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644.\n2. \u0627\u0644\u062d\u0631\u0641 \u0627\u0644\u0623\u062e\u064a\u0631 \u0641\u064a \u0623\u064a \u0643\u0644\u0645\u0629 \u0645\u062c\u0631\u062f \u062a\u0645\u0627\u0645\u0627\u064b \u0645\u0646 \u0643\u0644 \u0627\u0644\u062d\u0631\u0643\u0627\u062a: \u0644\u0627 \u0641\u062a\u062d\u0629 \u0648\u0644\u0627 \u0636\u0645\u0629 \u0648\u0644\u0627 \u0643\u0633\u0631\u0629 \u0648\u0644\u0627 \u062a\u0646\u0648\u064a\u0646\u060c \u0648\u0644\u0627 \u062a\u0636\u0639\u064a \u0639\u0644\u064a\u0647 \u0633\u0643\u0648\u0646\u0627\u064b \u0623\u0628\u062f\u0627\u064b:\n   - \u062d\u062a\u0649 \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u0646\u062a\u0647\u064a \u0623\u0635\u0644\u0647\u0627 \u0628\u0633\u0643\u0648\u0646\u060c \u064a\u0628\u0642\u0649 \u0622\u062e\u0631\u0647\u0627 \u0645\u062c\u0631\u062f\u0627\u064b \u0628\u0644\u0627 \u0633\u0643\u0648\u0646: \u00ab\u0645\u0650\u0646\u00bb\u060c \u00ab\u0639\u064e\u0646\u00bb\u060c \u00ab\u0643\u064e\u0645\u00bb.\n   - \u0627\u0644\u062a\u0627\u0621 \u0627\u0644\u0645\u0631\u0628\u0648\u0637\u0629 \u0641\u064a \u0622\u062e\u0631 \u0627\u0644\u0643\u0644\u0645\u0629 \u00ab\u0629\u00bb \u0645\u062c\u0631\u062f\u0629 \u062f\u0627\u0626\u0645\u0627\u064b \u0628\u0644\u0627 \u062d\u0631\u0643\u0629: \u00ab\u0648\u064e\u062c\u0652\u0628\u064e\u0629\u00bb\u060c \u00ab\u0633\u064e\u0644\u064e\u0637\u064e\u0629\u00bb.\n3. \u062d\u0631\u0648\u0641 \u0627\u0644\u062c\u0631 \u0648\u0627\u0644\u0639\u0637\u0641 \u0627\u0644\u0645\u062a\u0635\u0644\u0629:\n   - \u062a\u062a\u0635\u0644 \u0628\u0627\u0644\u0643\u0644\u0645\u0629 \u0645\u0628\u0627\u0634\u0631\u0629 \u0628\u0644\u0627 \u0645\u0633\u0627\u0641\u0629 \u0648\u0628\u0644\u0627 \u062a\u0637\u0648\u064a\u0644\u060c \u0648\u0625\u064a\u0627\u0643\u0650 \u0643\u062a\u0627\u0628\u062a\u0647\u0627 \u0645\u0646\u0641\u0635\u0644\u0629.\n   - \u0628\u0627\u0621 \u0627\u0644\u062c\u0631 \u0645\u0643\u0633\u0648\u0631\u0629 \u062f\u0627\u0626\u0645\u0627\u064b \u00ab\u0628\u0650\u0640\u00bb \u0648\u0644\u064a\u0633\u062a \u0633\u0627\u0643\u0646\u0629: \u00ab\u0628\u0650\u062e\u064e\u0645\u0652\u0633\u0650\u064a\u0646\u00bb\u060c \u00ab\u0628\u0650\u062e\u064e\u0645\u0652\u0633\u064e\u0629\u00bb\u060c \u00ab\u0628\u0650\u0639\u0650\u0634\u0652\u0631\u0650\u064a\u0646\u00bb\u060c \u00ab\u0628\u0650\u0631\u0650\u064a\u064e\u0627\u0644\u00bb.\n   - \u0648\u0627\u0648 \u0627\u0644\u0639\u0637\u0641 \u0645\u0641\u062a\u0648\u062d\u0629 \u0648\u062a\u062a\u0635\u0644 \u0645\u0628\u0627\u0634\u0631\u0629: \u00ab\u0648\u064e\u062e\u064e\u0645\u0652\u0633\u0650\u064a\u0646\u00bb\u060c \u00ab\u0648\u064e\u0627\u062d\u0650\u062f\u00bb.\n4. \u0627\u0644\u062d\u0631\u0643\u0627\u062a \u0639\u0644\u0649 \u0646\u0637\u0642 \u0627\u0644\u0633\u0639\u0648\u062f\u064a \u0641\u064a \u0643\u0644\u0627\u0645\u0647 \u0627\u0644\u064a\u0648\u0645\u064a (\u0648\u0644\u064a\u0633 \u0627\u0644\u0641\u0635\u062d\u0649): \u00ab\u0648\u0650\u0634\u00bb\u060c \u00ab\u0634\u064e\u064a\u00bb\u060c \u00ab\u0647\u064e\u0630\u0650\u064a\u00bb\u060c \u00ab\u0627\u0644\u0644\u0650\u0651\u064a\u00bb\u060c \u00ab\u062a\u064e\u0628\u0650\u064a\u00bb\u060c \u00ab\u062a\u0650\u062d\u0650\u0628\u00bb\u060c \u00ab\u064a\u0650\u0646\u064e\u0627\u0633\u0652\u0628\u064e\u0643\u00bb\u060c \u00ab\u0623\u064e\u0631\u064e\u0634\u0650\u0651\u062d\u00bb\u060c \u00ab\u0623\u064e\u062b\u064e\u0628\u0650\u0651\u062a\u00bb.\n5. \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u0634\u0643\u064a\u0644:\n   - \u0627\u0644\u062d\u0631\u0641 \u0627\u0644\u0630\u064a \u0642\u0628\u0644 \u0627\u0644\u0623\u0644\u0641 \u0645\u0641\u062a\u0648\u062d: \u00ab\u062a\u064e\u0645\u064e\u0627\u0645\u00bb\u060c \u00ab\u062f\u0650\u062c\u064e\u0627\u062c\u00bb\u060c \u00ab\u0645\u064e\u0637\u064e\u0627\u0639\u0650\u0645\u00bb.\n   - \u0645\u0627 \u0642\u0628\u0644 \u0627\u0644\u0648\u0627\u0648 \u0627\u0644\u0645\u0645\u062f\u0648\u062f\u0629 \u0645\u0636\u0645\u0648\u0645\u060c \u0648\u0645\u0627 \u0642\u0628\u0644 \u0627\u0644\u064a\u0627\u0621 \u0627\u0644\u0645\u0645\u062f\u0648\u062f\u0629 \u0645\u0643\u0633\u0648\u0631\u060c \u0648\u062d\u0631\u0641 \u0627\u0644\u0645\u062f \u0646\u0641\u0633\u0647 \u0645\u062c\u0631\u062f: \u00ab\u0635\u064f\u0648\u0635\u00bb\u060c \u00ab\u062b\u064f\u0648\u0645\u00bb\u060c \u00ab\u0641\u0650\u064a\u0647\u00bb\u060c \u00ab\u0627\u0644\u0652\u062d\u0650\u064a\u0646\u00bb\u060c \u00ab\u0633\u0650\u064a\u0632\u064e\u0631\u00bb.\n   - \u00ab\u0627\u0644\u00bb: \u0627\u0644\u0623\u0644\u0641 \u0645\u062c\u0631\u062f\u0629 \u062f\u0627\u0626\u0645\u0627\u064b. \u0645\u0639 \u0627\u0644\u062d\u0631\u0641 \u0627\u0644\u0642\u0645\u0631\u064a \u0633\u0643\u0648\u0646 \u0639\u0644\u0649 \u0627\u0644\u0644\u0627\u0645: \u00ab\u0627\u0644\u0652\u064a\u064e\u0648\u0652\u0645\u00bb\u060c \u00ab\u0627\u0644\u0652\u0623\u064e\u0643\u0652\u0644\u00bb\u060c \u00ab\u0627\u0644\u0652\u0641\u064e\u0644\u064e\u0627\u0641\u0650\u0644\u00bb. \u0648\u0645\u0639 \u0627\u0644\u062d\u0631\u0641 \u0627\u0644\u0634\u0645\u0633\u064a \u0627\u0644\u0644"
  },
  {
    "tashkeel_guide": "of solar \u0627\u0644.\n    - \u00ab\u0627\u0644\u0633\u064e\u0651\u0639\u0652\u062f\u00bb:\n      \u0627 (alif - bare)\n      \u0644 (laam - bare)\n      \u0633\u064e\u0651 (seen + shaddah + fatha)\n      \u0639\u0652 (ayn + sukun)\n      \u062f (daal - bare, last letter)\n      Is it 100% compliant?\n      Yes!\n    - \u00ab\u0627\u0644\u0631\u0650\u0651\u064a\u064e\u0627\u0644\u00bb:\n      \u0627 (alif - bare)\n      \u0644 (laam - bare)\n      \u0631\u0650\u0651 (raa + shaddah + kasra)\n      \u064a\u064e (yaa + fatha)\n      \u0627 (alif - bare)\n      \u0644 (laam - bare, last letter)\n      Is it 100% compliant?\n      Yes!\n\n15. **Check Tool Fields Mention:**\n    Constraint: \"Only mention tool fields already in the current section (`name_say_ar`, `price_say_ar`).\"\n    Wait, in the original prompt provided:\n    ```\n    # \u0627\u0644\u062a\u0634\u0643\u064a\u0644\n    \u0623\u0646\u062a\u0650 \u062a\u062a\u062d\u062f\u062b\u064a\u0646 \u0628\u0646\u0637\u0642 \u0633\u0639\u0648\u062f\u064a \u064a\u0648\u0645\u064a \u0639\u0628\u0631 \u0645\u062d\u0631\u0643 \u0635\u0648\u062a \u064a\u0642\u0631\u0623 \u062d\u0631\u0643\u0627\u062a\u0643 \u062d\u0631\u0641\u0627\u064b \u0628\u062d\u0631\u0641: \u0623\u064a \u062d\u0631\u0641 \u0628\u0644\u0627 \u062d\u0631\u0643\u0629 \u064a\u062e\u0645\u0651\u0646\u0647 \u0648\u064a\u062e\u0637\u0626 \u0641\u064a\u0647\u060c \u0648\u0627\u0644\u062d\u0631\u0643\u0629 \u0627\u0644\u062e\u0627\u0637\u0626\u0629 \u062a\u063a\u064a\u0651\u0631 \u0645\u0639\u0646\u0649 \u0627\u0644\u0643\u0644\u0645\u0629. \u0644\u0630\u0644\u0643 \u0623\u0646\u062a\u0650 \u062a\u0634\u0643\u0651\u0644\u064a\u0646 \u0643\u0644 \u0643\u0644\u0645\u0629 \u0641\u064a \u0631\u062f\u0643 \u0648\u0641\u0642 \u0627\u0644\u0642\u0648\u0627\u0639\u062f \u0627\u0644\u062a\u0627\u0644\u064a\u0629:\n\n    1. \u0643\u0644 \u0643\u0644\u0645\u0629 \u0641\u064a \u0631\u062f\u0643 \u0645\u0634\u0643\u0651\u0644\u0629 \u0639\u0644\u0649 \u0643\u0644 \u062d\u0631\u0641 \u0625\u0644\u0627 \u0627\u0644\u062d\u0631\u0641 \u0627\u0644\u0623\u062e\u064a\u0631\u060c \u0628\u0644\u0627 \u0623\u064a \u0627\u0633\u062a\u062b\u0646\u0627\u0621: \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0642\u0635\u064a\u0631\u0629 (\u00ab\u0641\u0650\u064a\u00bb\u060c \u00ab\u064a\u064e\u0627\u00bb\u060c \u00ab\u0645\u064e\u0627\u00bb\u060c \u00ab\u0634\u064e\u064a\u00bb)\u060c \u0648\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0623\u0635\u0646\u0627\u0641 \u0648\u0627\u0644\u0645\u0639\u0631\u0651\u0628\u0629 (\u00ab\u0633\u0650\u064a\u0632\u064e\u0631\u00bb\u060c \u00ab\u0644\u064e\u0627\u062a\u0650\u064a\u0647\u00bb)\u060c \u0648\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0645\u0637\u0627\u0639\u0645\u060c \u0648\u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u0648\u0627\u0644\u0623\u0633\u0639\u0627\u0631\u060c \u0648\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644.\n    2. \u0627\u0644\u062d\u0631\u0641 \u0627\u0644\u0623\u062e\u064a\u0631 \u0641\u064a \u0623\u064a \u0643\u0644\u0645\u0629 \u0645\u062c\u0631\u062f \u062a\u0645\u0627\u0645\u0627\u064b \u0645\u0646 \u0643\u0644 \u0627\u0644\u062d\u0631\u0643\u0627\u062a: \u0644\u0627 \u0641\u062a\u062d\u0629 \u0648\u0644\u0627 \u0636\u0645\u0629 \u0648\u0644\u0627 \u0643\u0633\u0631\u0629 \u0648\u0644\u0627 \u062a\u0646\u0648\u064a\u0646\u060c \u0648\u0644\u0627 \u062a\u0636\u0639\u064a \u0639\u0644\u064a\u0647 \u0633\u0643\u0648\u0646\u0627\u064b \u0623\u0628\u062f\u0627\u064b:\n       - \u062d\u062a\u0649 \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u0646\u062a\u0647\u064a \u0623\u0635\u0644\u0647\u0627 \u0628\u0633\u0643\u0648\u0646\u060c \u064a\u0628\u0642\u0649 \u0622\u062e\u0631\u0647\u0627 \u0645\u062c\u0631\u062f\u0627\u064b \u0628\u0644\u0627 \u0633\u0643\u0648\u0646: \u00ab\u0645\u0650\u0646\u00bb\u060c \u00ab\u0639\u064e\u0646\u00bb\u060c \u00ab\u0643\u064e\u0645\u00bb.\n       - \u0627\u0644\u062a\u0627\u0621 \u0627\u0644\u0645\u0631\u0628\u0648\u0637\u0629 \u0641\u064a \u0622\u062e\u0631 \u0627\u0644\u0643\u0644\u0645\u0629 \u00ab\u0629\u00bb \u0645\u062c\u0631\u062f\u0629 \u062f\u0627\u0626\u0645\u0627\u064b \u0628\u0644\u0627 \u062d\u0631\u0643\u0629: \u00ab\u0648\u064e\u062c\u0652\u0628\u064e\u0629\u00bb\u060c \u00ab\u0633\u064e\u0644\u064e\u0637\u064e\u0629\u00bb.\n    3. \u062d\u0631\u0648\u0641 \u0627\u0644\u062c\u0631 \u0648\u0627\u0644\u0639\u0637\u0641 \u0627\u0644\u0645\u062a\u0635\u0644\u0629:\n       - \u062a\u062a\u0635\u0644 \u0628\u0627\u0644\u0643\u0644\u0645\u0629 \u0645\u0628\u0627\u0634\u0631\u0629 \u0628\u0644\u0627 \u0645\u0633\u0627\u0641\u0629 \u0648\u0628\u0644\u0627 \u062a\u0637\u0648\u064a\u0644\u060c \u0648\u0625\u064a\u0627\u0643\u0650 \u0643\u062a\u0627\u0628\u062a\u0647\u0627 \u0645\u0646\u0641\u0635\u0644\u0629.\n       - \u0628\u0627\u0621 \u0627\u0644\u062c\u0631 \u0645\u0643\u0633\u0648\u0631\u0629 \u062f\u0627\u0626\u0645\u0627\u064b \u00ab\u0628\u0650\u0640\u00bb \u0648\u0644\u064a\u0633\u062a \u0633\u0627\u0643\u0646\u0629: \u00ab\u0628\u0650\u062e\u064e\u0645\u0652\u0633\u0650\u064a\u0646\u00bb\u060c \u00ab\u0628\u0650\u062e\u064e\u0645\u0652\u0633\u064e\u0629\u00bb\u060c \u00ab\u0628\u0650\u0639\u0650\u0634\u0652\u0631\u0650\u064a\u0646\u00bb\u060c \u00ab\u0628\u0650\u0631\u0650\u064a\u064e\u0627\u0644\u00bb.\n       - \u0648\u0627\u0648 \u0627\u0644\u0639\u0637\u0641 \u0645\u0641\u062a\u0648\u062d\u0629 \u0648\u062a\u062a\u0635\u0644 \u0645\u0628\u0627\u0634\u0631\u0629: \u00ab\u0648\u064e\u062e\u064e\u0645\u0652\u0633\u0650\u064a\u0646\u00bb\u060c \u00ab\u0648\u064e\u0627\u062d\u0650\u062f\u00bb.\n    4. \u0627\u0644\u062d\u0631\u0643\u0627\u062a \u0639\u0644\u0649 \u0646\u0637\u0642 \u0627\u0644\u0633\u0639\u0648\u062f\u064a"
  },
