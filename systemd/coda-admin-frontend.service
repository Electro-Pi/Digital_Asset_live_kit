[Unit]
Description=CODA secure admin dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=coda-admin
Group=coda-admin
WorkingDirectory=/home/Coda-digital-asset/Digital_Asset_live_kit/frontend/coda-admin
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=8092
EnvironmentFile=/etc/coda-admin/admin.env
ExecStart=/opt/coda-node22/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 8092
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
SuccessExitStatus=143
UMask=0077

# The service needs network access and read access to its production build, but
# it never needs root privileges or access to other users' home directories.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/Coda-digital-asset/Digital_Asset_live_kit/frontend/coda-admin/.next/cache
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=coda-admin

[Install]
WantedBy=multi-user.target
