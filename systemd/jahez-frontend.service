[Unit]
Description=Jahez Next.js frontend (لقمة mockup)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bassem
Group=bassem
WorkingDirectory=/home/bassem/projects/jahez-project/jahez-frontend
Environment=NODE_ENV=production
Environment=HOME=/home/bassem
# Bound to loopback only — nginx on laqma.testdevelopment.top is the public entry.
EnvironmentFile=/home/bassem/projects/jahez-project/jahez-frontend/.env.local
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 6701
Restart=always
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jahez-frontend

[Install]
WantedBy=multi-user.target
