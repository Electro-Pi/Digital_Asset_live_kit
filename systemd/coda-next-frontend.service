[Unit]
Description=CODA Next.js frontend (coda-next playground)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bassem
Group=bassem
WorkingDirectory=/home/bassem/Coda/Digital_Asset_live_kit/frontend/coda-frontend/coda-next
Environment=NODE_ENV=production
# Loads LIVEKIT_* (token route, runtime), the Supabase and Moyasar secrets, and
# PORT. NEXT_PUBLIC_* values are baked in at build time, so rebuild after
# changing NEXT_PUBLIC_LIVEKIT_URL or NEXT_PUBLIC_SUPABASE_*.
EnvironmentFile=/home/bassem/Coda/Digital_Asset_live_kit/frontend/coda-frontend/coda-next/.env.local
# Node 22 from /opt/coda-node22 — this host has no /usr/bin/node.
# --hostname 127.0.0.1 keeps 8090 off the public interface; nginx fronts it.
ExecStart=/opt/coda-node22/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 -p 8090
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=coda-next-frontend

[Install]
WantedBy=multi-user.target
