[Unit]
Description=LEAP Map Navigator LiveKit Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/navigator-ai/Digital_Asset_live_kit
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/navigator-ai/Digital_Asset_live_kit/.env.remote
EnvironmentFile=/home/navigator-ai/Digital_Asset_live_kit/.env.navigator
ExecStart=/home/navigator-ai/Digital_Asset_live_kit/.venv/bin/python agent.py start
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
