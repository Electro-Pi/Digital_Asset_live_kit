[Unit]
Description=LEAP Map Navigator LiveKit Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bassem
Group=bassem
WorkingDirectory=/home/bassem/Coda-navigator/Digital_Asset_live_kit
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/bassem/Coda/Digital_Asset_live_kit/.env.local
# This deployment shares the existing Coda LiveKit/model credentials, but its
# named dispatch and health port are isolated from coda-agent.service.
ExecStart=/usr/bin/env AGENT_NAME=leap-navigator AGENT_PORT=2954 AGENT_IDLE_PROCESSES=1 /home/bassem/Coda-navigator/Digital_Asset_live_kit/.venv/bin/python agent.py start
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=map-navigator-agent

[Install]
WantedBy=multi-user.target
