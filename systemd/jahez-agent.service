[Unit]
Description=Jahez CODA LiveKit voice agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bassem
Group=bassem
WorkingDirectory=/home/bassem/projects/jahez-project/coda-jahez-agent-backend
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/bassem
# LIVEKIT_*, AGENT_PORT (6700) and the TTS/STT/LLM backends.
EnvironmentFile=/home/bassem/projects/jahez-project/coda-jahez-agent-backend/.env.local
ExecStart=/home/bassem/projects/jahez-project/coda-jahez-agent-backend/.venv/bin/python agent.py start
Restart=always
RestartSec=5
TimeoutStopSec=90
KillMode=control-group
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jahez-agent

[Install]
WantedBy=multi-user.target
