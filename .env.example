LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""
NEXT_PUBLIC_LIVEKIT_URL=""

GROQ_API_KEY=""

ELEVEN_API_KEY=""

# ─── Model backends ──────────────────────────────────────────────────────────
# TTS: sglang-omni. `MOSS_TTS_VOICE` must be a name from GET /v1/audio/voices —
# "default" on a server with nothing uploaded, "coda-2" once the production clip
# (ref-audio/coda-2.wav) has been registered via POST /v1/audio/voices. That
# upload must include ref_text (ref-audio/ref-text-coda-2); without it the
# server still lists the voice but synthesizes with the default speaker.
MOSS_TTS_SERVER_URL=""
MOSS_TTS_MODEL=""
MOSS_TTS_VOICE="coda-2"
# Warn on every request whose voice differs from this. Leave equal to
# MOSS_TTS_VOICE unless you are deliberately testing another speaker.
MOSS_TTS_EXPECTED_VOICE="coda-2"

# Leave empty to use the TTS server's uploaded voice. Set this only to
# a path that exists inside the TTS server container/host.
MOSS_TTS_REF_AUDIO=""

# Delivery pace. Below 1.0 is slower, and the stretch is pitch-preserving, so
# the speaker is unchanged — do NOT use the server's own `speed`, which
# resamples and drags pitch/formants along with it. Useful range is 0.85-1.0;
# below ~0.8 the stretch starts to sound smeared.
MOSS_TTS_SPEED="0.92"

# LLM + STT: OpenAI-compatible vLLM servers. The API keys are required whenever
# vLLM was started with --api-key (all /v1/* routes 401 without them) and can be
# left empty for an unauthenticated local server.
LLM_BASE_URL=""
LLM_MODEL=""
LLM_API_KEY=""

# Base URL without the /v1 suffix (a trailing /v1 is tolerated and stripped).
STT_BASE_URL=""
STT_MODEL=""
STT_API_KEY=""

# Speech gate. Increase activation threshold/minimum duration if incidental
# room sounds still trigger transcription; lower them for very quiet speakers.
STT_VAD_ACTIVATION_THRESHOLD="0.65"
STT_VAD_DEACTIVATION_THRESHOLD="0.45"
STT_VAD_MIN_SPEECH_DURATION="0.20"
STT_VAD_MIN_SILENCE_DURATION="0.60"
STT_VAD_PREFIX_PADDING_DURATION="0.30"
STT_FOREGROUND_MIN_RMS="0.015"
STT_FOREGROUND_MIN_SNR_DB="8.0"
STT_FOREGROUND_MIN_DURATION="0.20"

# ─── Supabase (agent-side live-minute billing) ───────────────────────────────
# Service-role key is SERVER-ONLY and secret. The agent uses it to read each
# caller's remaining live budget and record consumed live seconds.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Medical guideline RAG ───────────────────────────────────────────────────
# Vector store. `docker compose up -d` brings this up; the ports are shifted off
# Qdrant's 6333/6334 defaults because another project owns those on this host.
QDRANT_URL="http://localhost:6335"
QDRANT_HTTP_PORT="6335"
QDRANT_GRPC_PORT="6336"
QDRANT_API_KEY=""
# Reads go through this alias. Ingestion builds `<alias>_<CORPUS_VERSION>` and
# repoints the alias only once the new collection is complete and verified.
QDRANT_COLLECTION="medical_guidelines"
CORPUS_VERSION="v1"

# Embeddings. Gemini is used because it handles Arabic queries against English
# guideline text directly, which removes a translation hop from every turn.
# 1536 is a Matryoshka truncation of the model's native 3072 dimensions — change
# it and you must rebuild the index, since old vectors become unreadable.
# A PAID key is required to index the full corpus: the free tier caps
# embed_content at 1,000 requests PER DAY and each text counts as one request,
# against a corpus of ~2,300 chunks. `index --resume` lets a free key finish the
# build across several days.
GOOGLE_API_KEY=""
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIM="1536"
# Keep this small on the free tier: a 32-text batch spends 32 quota units at
# once and trips the burst limit even when the per-minute average is fine.
EMBEDDING_BATCH_SIZE="4"
EMBEDDING_TIMEOUT_S="10.0"
# Quota budget per embedded text. Gemini free tier counts 100 texts per minute
# (batching does not exempt them). Lower to near zero on a paid key.
EMBEDDING_SECONDS_PER_ITEM="0.8"

# Retrieval. RAG_TIMEOUT_MS caps everything between end-of-utterance and the LLM
# call; exceeding it drops the evidence rather than the turn, and the prompt's
# "no evidence" rule then makes the agent refer the patient instead of guessing.
RAG_TOP_K="4"
RAG_SCORE_THRESHOLD="0.55"
RAG_TIMEOUT_MS="700"
RAG_HISTORY_TURNS="4"
# Run the classifier and the embed+search concurrently instead of in sequence.
# Costs a few discarded embedding calls, saves ~200ms on every clinical turn.
RAG_SPECULATIVE="true"

# Query classifier. Runs on the same vLLM endpoint as the agent; leave
# CLASSIFIER_MODEL empty to reuse LLM_MODEL.
CLASSIFIER_MODEL=""
CLASSIFIER_MAX_TOKENS="8"
CLASSIFIER_TIMEOUT_S="3.0"

# Patient utterances are health information. Leave false on any deployed box —
# this only re-enables raw transcripts in logs for local debugging.
LOG_SENSITIVE_CONTENT="false"
