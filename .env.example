LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""
NEXT_PUBLIC_LIVEKIT_URL=""

GROQ_API_KEY=""

ELEVEN_API_KEY=""

# ─── Model backends ──────────────────────────────────────────────────────────
# TTS: VoxCPM2 on vLLM. `TTS_SERVER_URL` takes NO /v1 suffix — the plugin
# appends /v1/audio/speech to it. `TTS_VOICE` must be a name from
# GET /v1/audio/voices — "hoda" is the precomputed production female voice,
# "default" is the male speaker. An unregistered name returns 400 and an unknown
# `TTS_MODEL` returns 404, so both fail loudly rather than falling back.
# The live agent also accepts a per-session voice toggle from the frontend:
# female → this server-side voice (نوف), male → ref-audio/male.wav + male-ref-text (نواف).
TTS_SERVER_URL=""
TTS_MODEL="VoxCPM2"
TTS_VOICE="hoda"
# Warn on every request whose voice differs from this. Leave equal to
# TTS_VOICE unless you are deliberately testing another speaker.
TTS_EXPECTED_VOICE="hoda"

# Leave empty to use the TTS server's own voice. Set this only to
# a path that exists inside the TTS server container/host.
TTS_REF_AUDIO=""

# Delivery pace. 1.0 bypasses the stretch entirely and is the default.
#
# Below 1.0 is slower and pitch-preserving, so the speaker is unchanged — do NOT
# use the server's own `speed`, which resamples and drags pitch/formants with it.
# But the stretch adds duration by repeating pitch periods, which duplicates
# speech transients and is audible as a slight stutter on consonants: measured
# +2.4% spurious onsets at 0.97, +7.3% at 0.92, +9.5% at 0.88. Only go below 1.0
# if the voice genuinely needs slowing, and prefer the smallest change that works.
TTS_SPEED="1.0"

# Short vowels (tashkeel) sent to the TTS. Default 0 = keep them: the لقمة
# prompt emits tashkeel on every letter but the last of each word so the TTS
# reads vowels instead of guessing. Set to 1 to strip them again (then relax
# the tashkeel rule in src/prompts/agent_prompt.py to match).
TTS_STRIP_TASHKEEL="0"

# LLM + STT: OpenAI-compatible vLLM servers. The API keys are required whenever
# vLLM was started with --api-key (all /v1/* routes 401 without them) and can be
# left empty for an unauthenticated local server.
LLM_BASE_URL=""
LLM_MODEL=""
LLM_API_KEY=""

# Base URL without the /v1 suffix (a trailing /v1 is tolerated and stripped).
STT_BASE_URL=""
STT_MODEL=""
STT_API_KEY=""

# Speech gate. Increase activation threshold/minimum duration if incidental
# room sounds still trigger transcription; lower them for very quiet speakers.
STT_VAD_ACTIVATION_THRESHOLD="0.65"
STT_VAD_DEACTIVATION_THRESHOLD="0.45"
STT_VAD_MIN_SPEECH_DURATION="0.20"
STT_VAD_MIN_SILENCE_DURATION="0.60"
STT_VAD_PREFIX_PADDING_DURATION="0.30"
STT_FOREGROUND_MIN_RMS="0.015"
STT_FOREGROUND_MIN_SNR_DB="8.0"
STT_FOREGROUND_MIN_DURATION="0.20"
