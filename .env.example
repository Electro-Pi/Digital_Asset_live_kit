LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL=""
NEXT_PUBLIC_LIVEKIT_URL=""

GROQ_API_KEY=""

ELEVEN_API_KEY=""

# ─── Model backends ──────────────────────────────────────────────────────────
# TTS: VoxCPM2 on vLLM. `TTS_SERVER_URL` takes NO /v1 suffix — the plugin
# appends /v1/audio/speech to it. Both voice names must come from
# GET /v1/audio/voices — "nouf" (نوف) and "nawaf" (نواف) are the precomputed
# production speakers. An unregistered name returns 400 and an unknown
# `TTS_MODEL` returns 404, so both fail loudly rather than falling back.
# The live agent picks between them per session from the frontend's voice
# toggle, carried in the participant metadata.
TTS_SERVER_URL=""
TTS_MODEL="VoxCPM2"
TTS_VOICE="nouf"
TTS_VOICE_MALE="nawaf"

# Leave empty to use the server-side voices above. Set this only to clone from a
# reference instead — a path inside the TTS server container/host, a URL, or a
# data URI. It overrides whichever voice the session picked, and costs ~45s to
# first audio versus ~0.3s for a named voice, so it is not a live-path option.
TTS_REF_AUDIO=""

# Delivery pace. 1.0 bypasses the stretch entirely and is the default.
#
# Below 1.0 is slower and pitch-preserving, so the speaker is unchanged — do NOT
# use the server's own `speed`, which resamples and drags pitch/formants with it.
# But the stretch adds duration by repeating pitch periods, which duplicates
# speech transients and is audible as a slight stutter on consonants: measured
# +2.4% spurious onsets at 0.97, +7.3% at 0.92, +9.5% at 0.88. Only go below 1.0
# if the voice genuinely needs slowing, and prefer the smallest change that works.
TTS_SPEED="1.0"

# LLM + STT: OpenAI-compatible vLLM servers. The API keys are required whenever
# vLLM was started with --api-key (all /v1/* routes 401 without them) and can be
# left empty for an unauthenticated local server.
LLM_BASE_URL=""
LLM_MODEL=""
LLM_API_KEY=""

# Base URL without the /v1 suffix (a trailing /v1 is tolerated and stripped).
STT_BASE_URL=""
STT_MODEL=""
STT_API_KEY=""

# Speech gate. Increase activation threshold/minimum duration if incidental
# room sounds still trigger transcription; lower them for very quiet speakers.
STT_VAD_ACTIVATION_THRESHOLD="0.65"
STT_VAD_DEACTIVATION_THRESHOLD="0.45"
STT_VAD_MIN_SPEECH_DURATION="0.20"
STT_VAD_MIN_SILENCE_DURATION="0.60"
STT_VAD_PREFIX_PADDING_DURATION="0.30"
STT_FOREGROUND_MIN_RMS="0.015"
STT_FOREGROUND_MIN_SNR_DB="8.0"
STT_FOREGROUND_MIN_DURATION="0.20"

# ─── LEAP exhibitor assistant ────────────────────────────────────────────────
LEAP_ENABLED="true"
LEAP_DATA_DIR="/home/bassem/Coda/Call-center/coda-voice-pack"
LEAP_EMBEDDING_INDEX="/home/bassem/Coda/Call-center/coda-voice-pack/03-sqlite/company-embeddings.npz"
LEAP_VISITOR_DB="/home/bassem/Coda/Call-center/data/leap-visitors.sqlite"
LEAP_REGISTRATION_IDLE_SECONDS="8.0"
GEMINI_API_KEY=""
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_EMBEDDING_DIMENSIONS="768"
GEMINI_EMBEDDING_TIMEOUT_SECONDS="1.2"
AGENT_LOAD_THRESHOLD="0.95"

# ─── Supabase (agent-side live-minute billing) ───────────────────────────────
# Service-role key is SERVER-ONLY and secret. The agent uses it to read each
# caller's remaining live budget and record consumed live seconds.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
